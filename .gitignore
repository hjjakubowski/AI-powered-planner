# -----------------------------------------------------------------------------
# Build outputs and generated files
# -----------------------------------------------------------------------------
build/
out/
bin/
dist/
dist-ssr/
.vite/

# Keep Gradle wrapper JAR versioned.
!gradle/wrapper/gradle-wrapper.jar

# Allow unusually named source build/bin/out directories if they ever appear.
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/
!**/src/main/**/out/
!**/src/test/**/out/

# -----------------------------------------------------------------------------
# Gradle
# -----------------------------------------------------------------------------
.gradle/

# -----------------------------------------------------------------------------
# Node / frontend
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Unused root-level npm files from an earlier prototype.
/package.json
/package-lock.json

# -----------------------------------------------------------------------------
# Logs and runtime dumps
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# Environment, secrets and local overrides
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.local

src/main/resources/application-local.properties
src/main/resources/application-*.local.properties

docker-compose.override.yml
compose.override.yaml
compose.override.yml

# -----------------------------------------------------------------------------
# Local databases
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.mv.db
*.trace.db

# -----------------------------------------------------------------------------
# IDE and editor state
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Project-local scratch files and assignment materials
# -----------------------------------------------------------------------------
HELP.md
temp.gradle
*pdf
